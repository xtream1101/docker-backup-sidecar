# Docker Backup Sidecar Configuration (Restic-based)
# Copy this file to .env and configure for your service

# ============================================================================
# BACKUP NAME (REQUIRED)
# ============================================================================

# Unique name for this backup - used to tag and identify snapshots
# Examples: myapp-prod, website-staging, api-production
BACKUP_NAME=myapp-production

# ============================================================================
# RESTIC REPOSITORY (REQUIRED)
# ============================================================================

# Restic repository URL - supports any restic backend
# Local:  /backups-local/myapp
# S3:     s3:s3.us-east-1.amazonaws.com/bucket-name/myapp
# B2:     b2:bucket-name:myapp
# SFTP:   sftp:user@host:/backups/myapp
# REST:   rest:http://host:8000/myapp
RESTIC_REPOSITORY=/backups-local/myapp

# Repository encryption password (REQUIRED)
# Use a strong, random passphrase and store it securely!
# Without this password, backups cannot be restored!
RESTIC_PASSWORD=change-this-to-a-very-strong-passphrase

# S3 credentials (only needed for S3-compatible backends)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_DEFAULT_REGION=us-east-1

# ============================================================================
# BACKUP SCHEDULE & RETENTION
# ============================================================================

# Cron schedule (default: 2 AM daily)
# Omit or comment out for manual-only mode (no automatic backups)
BACKUP_SCHEDULE="0 2 * * *"

# Restic retention policy (applied via restic forget --prune)
RESTIC_KEEP_LAST=14
RESTIC_KEEP_DAILY=7
RESTIC_KEEP_WEEKLY=4
RESTIC_KEEP_MONTHLY=0
RESTIC_KEEP_YEARLY=0

# ============================================================================
# WHAT TO BACKUP - Configure based on your service
# ============================================================================

# PostgreSQL Databases
# Format: Standard PostgreSQL connection URI
# BACKUP_POSTGRES=postgresql://postgres:${DB_PASSWORD}@db:5432/myapp

# MongoDB Databases
# Format: Standard MongoDB connection URI
# BACKUP_MONGODB=mongodb://root:${MONGO_PASSWORD}@mongo:27017/mydb?authSource=admin

# Redis Databases
# Format: Standard Redis connection URI
# The Redis data directory must be mounted into the backup container
# BACKUP_REDIS=redis://redis:6379

# Where Redis data is mounted in the backup container (default: /redis-data)
# BACKUP_REDIS_DATA_DIR=/redis-data

# Directories to backup (restic backs these up directly for efficient dedup)
# Format: /path:name,/path2:name2
# BACKUP_DIRS=/data:app-data,/config:app-config

# Individual files to backup
# Format: /path/file:name,/path2/file2:name2
# For SQLite databases, use BACKUP_FILES with BACKUP_STOP_SERVICES
# BACKUP_FILES=/config/app.json:config,/data/app.db:database

# ============================================================================
# SERVICE MANAGEMENT
# ============================================================================

# Services/containers to stop before backup (comma-separated)
# Useful for SQLite databases or Redis when data consistency is critical
# BACKUP_STOP_SERVICES=app,worker

# Wait time after stopping services (seconds, default: 2)
# BACKUP_STOP_WAIT=2

# Wait time after starting services (seconds, default: 3)
# BACKUP_START_WAIT=3

# ============================================================================
# MONITORING & NOTIFICATIONS
# ============================================================================

# Webhook URLs for success/failure notifications
# Compatible with healthchecks.io, upptime, etc.
# BACKUP_SUCCESS_WEBHOOK=https://hc-ping.com/your-uuid
# BACKUP_FAILURE_WEBHOOK=https://hc-ping.com/your-uuid/fail

# ============================================================================
# ADVANCED OPTIONS
# ============================================================================

# Enable debug logging (default: false)
# BACKUP_DEBUG=true

# Timezone (default: UTC)
TZ=America/New_York

# ============================================================================
# EXAMPLE CONFIGURATIONS
# ============================================================================

# Example 1: Simple app with PostgreSQL + local backups
# RESTIC_REPOSITORY=/backups-local/myapp
# RESTIC_PASSWORD=strong-passphrase
# BACKUP_POSTGRES=postgresql://postgres:mypassword@db:5432/myapp
# BACKUP_DIRS=/data:app-data

# Example 2: App with Redis cache + PostgreSQL
# RESTIC_REPOSITORY=/backups-local/myapp
# RESTIC_PASSWORD=strong-passphrase
# BACKUP_POSTGRES=postgresql://postgres:pass@db:5432/myapp
# BACKUP_REDIS=redis://redis:6379
# BACKUP_STOP_SERVICES=redis

# Example 3: S3 backend with monitoring
# RESTIC_REPOSITORY=s3:s3.us-east-1.amazonaws.com/my-backups/myapp
# RESTIC_PASSWORD=strong-passphrase
# AWS_ACCESS_KEY_ID=xxx
# AWS_SECRET_ACCESS_KEY=xxx
# BACKUP_POSTGRES=postgresql://postgres:pass@db:5432/myapp
# BACKUP_SUCCESS_WEBHOOK=https://hc-ping.com/your-uuid
# BACKUP_FAILURE_WEBHOOK=https://hc-ping.com/your-uuid/fail
